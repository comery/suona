# ── dependencies ────────────────────────────────────────────────────────────
node_modules/
jspm_packages/
web_modules/
bower_components/

# ── build output ────────────────────────────────────────────────────────────
dist/
build/
src-tauri/target/

# Tauri regenerates these from tauri.conf.json and the capability files.
src-tauri/gen/

# ── local toolchain caches ──────────────────────────────────────────────────
# Kept inside the project so a build works under a restricted sandbox; never
# interesting to anyone else.
.cargo-home/
.pnpm-store/
.pnpm-cache/
.pnpm-debug.log*
.npm/
.vite/
*.tsbuildinfo

# The local .npmrc points at those caches, so it is machine-specific too.
.npmrc

# ── logs and runtime data ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids
*.pid
*.seed
*.pid.lock

# ── secrets ─────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── test and coverage output ────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
__pycache__/
*.py[cod]

# ── editors and tooling ─────────────────────────────────────────────────────
.idea/
.vscode/
.eslintcache
.stylelintcache
.DS_Store

# ── simulator output ────────────────────────────────────────────────────────
# scripts/simulate_dock.py writes a whole sheet of tiles; the two the README
# embeds are the only ones worth tracking.
assets/preview/*
!assets/preview/dock-simulation.png
!assets/preview/aim-simulation.png
